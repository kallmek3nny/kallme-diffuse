<?xml version="1.0" encoding="utf-8"?>
<!--
  Clone of the original Diffuse settings UI.

  Structure mirrors the decompiled `layout_main_fragment.xml`: a NestedScrollView with 12dp
  vertical padding holding a vertical stack of cards. Each card matches
  `layout_main_frag_config.xml` / `layout_main_frag_playing.xml`: transparent background,
  0dp elevation, 2dp colorOnSurface stroke, 16dp inner padding, Overline-style labels, and a
  1dp 60%-alpha divider (`layout_line.xml`) under each card title.

  The live wallpaper renders behind this, exactly as in the original.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <com.gushypushy.diffusereborn.DiffusePreviewView
        android:id="@+id/classicPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/classicScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:animateLayoutChanges="true">

            <!-- LAST PLAYING (layout_main_frag_playing.xml) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/classic_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/label_last_playing"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:alpha="0.6"
                    android:background="@drawable/classic_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/classicArt"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_marginEnd="12dp"
                        android:adjustViewBounds="true"
                        android:contentDescription="@string/label_last_playing"
                        android:scaleType="fitCenter" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/classicTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.16"
                            android:text="@string/label_no_track"
                            android:textAllCaps="true"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/classicArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:letterSpacing="0.16"
                            android:textAllCaps="true"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/classicOpenMusic"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/classic_button"
                            android:letterSpacing="0.16"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/button_open_music_application"
                            android:textAllCaps="true"
                            android:textColor="#FFFFFFFF"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- GRAPHICS SETTINGS (layout_main_frag_config.xml) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/classic_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/label_graphics_settings"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:alpha="0.6"
                    android:background="@drawable/classic_divider" />

                <TextView
                    android:id="@+id/lblClassicScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/label_fluid_scale"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekClassicScale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/lblClassicSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.16"
                    android:text="@string/label_speed_min_max"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekClassicSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100" />

                <TextView
                    android:id="@+id/lblClassicStrength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:letterSpacing="0.16"
                    android:text="@string/label_strength"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekClassicStrength"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100" />
            </LinearLayout>

            <!-- SETUP (layout_main_frag_setup.xml equivalent) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@drawable/classic_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/label_setup"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="12dp"
                    android:alpha="0.6"
                    android:background="@drawable/classic_divider" />

                <Button
                    android:id="@+id/classicAllowNotif"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/classic_button"
                    android:letterSpacing="0.16"
                    android:text="@string/button_allow_read_notification"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/classicSetWallpaper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/classic_button"
                    android:letterSpacing="0.16"
                    android:text="@string/button_set_wallpaper"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/classicExit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/classic_button"
                    android:letterSpacing="0.16"
                    android:text="@string/label_classic_gui"
                    android:textAllCaps="true"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
