<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080A10">

    <com.gushypushy.diffusereborn.DiffusePreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/preview_scrim"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/mainContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="26dp"
            android:paddingEnd="22dp"
            android:paddingBottom="150dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.18"
                android:text="LIVE WALLPAPER"
                android:textAllCaps="true"
                android:textColor="#A9C9FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:letterSpacing="-0.025"
                android:text="Diffuse Reborn"
                android:textColor="#FFF9FBFF"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textRendererCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Album color, shaped by sound"
                android:textColor="#B9C3D2"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/nowPlayingIsland"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/glass_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/live_dot" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:text="NOW PLAYING"
                        android:textAllCaps="true"
                        android:textColor="#AAB7C9"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textRendererPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/renderer_pill"
                        android:paddingStart="9dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="9dp"
                        android:paddingBottom="5dp"
                        android:text="OG DIFFUSE"
                        android:textColor="#D8E6FF"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgAlbumArt"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:background="@drawable/rounded_art"
                        android:clipToOutline="true"
                        android:contentDescription="Current album artwork"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_music_placeholder" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textTrackTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Nothing playing"
                            android:textColor="#FFF9FBFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textTrackArtist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Start music to see its colors here"
                            android:textColor="#B7C1D0"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:id="@+id/paletteSwatches"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:contentDescription="Colors sampled from the current album artwork"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="Setup" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    android:id="@+id/textPermissionStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="Checking notification access…"
                    android:textColor="#C4CDDA"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnNotifPerm"
                    style="@style/CardButton"
                    android:layout_marginTop="12dp"
                    android:text="Grant notification access" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="Field" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/CardCaption"
                    android:text="A blurred wash of album color, slowly reshaped by animated noise." />

                <include
                    android:id="@+id/rowOgScale"
                    layout="@layout/item_slider" />

                <include
                    android:id="@+id/rowOgSpeed"
                    layout="@layout/item_slider" />

                <include
                    android:id="@+id/rowOgTransition"
                    layout="@layout/item_slider" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="Reactivity" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/CardCaption"
                    android:text="Audio response is optional. Grant microphone access to let bass move the field." />

                <include
                    android:id="@+id/rowBeat"
                    layout="@layout/item_slider" />

                <include
                    android:id="@+id/rowOgStrength"
                    layout="@layout/item_slider" />

                <Button
                    android:id="@+id/btnAudioPermission"
                    style="@style/CardButton"
                    android:layout_marginTop="8dp"
                    android:text="Allow audio response" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="Colour" />

            <LinearLayout style="@style/SettingsCard">

                <include
                    android:id="@+id/rowSat"
                    layout="@layout/item_slider" />

                <include
                    android:id="@+id/rowBright"
                    layout="@layout/item_slider" />

                <include
                    android:id="@+id/rowHue"
                    layout="@layout/item_slider" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="Finish" />

            <LinearLayout style="@style/SettingsCard">

                <include
                    android:id="@+id/rowVignette"
                    layout="@layout/item_slider" />

                <include
                    android:id="@+id/rowGrain"
                    layout="@layout/item_slider" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="Album art" />

            <LinearLayout style="@style/SettingsCard">

                <include
                    android:id="@+id/rowCenterArt"
                    layout="@layout/item_switch" />

                <LinearLayout
                    android:id="@+id/groupCenterArt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        android:id="@+id/rowCenterSize"
                        layout="@layout/item_slider" />

                    <include
                        android:id="@+id/rowCenterBlur"
                        layout="@layout/item_slider" />

                    <include
                        android:id="@+id/rowCenterOpacity"
                        layout="@layout/item_slider" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="Now-playing overlay" />

            <LinearLayout style="@style/SettingsCard">

                <include
                    android:id="@+id/rowWidget"
                    layout="@layout/item_switch" />

                <LinearLayout
                    android:id="@+id/groupWidget"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/rowWidgetScale"
                        layout="@layout/item_slider" />

                    <include
                        android:id="@+id/rowPosX"
                        layout="@layout/item_slider" />

                    <include
                        android:id="@+id/rowPosY"
                        layout="@layout/item_slider" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="Music sources" />

            <LinearLayout style="@style/SettingsCard">

                <TextView
                    style="@style/CardCaption"
                    android:text="Choose which apps Diffuse reacts to. With no allow list, every app is considered." />

                <Button
                    android:id="@+id/btnWhitelist"
                    style="@style/CardButton"
                    android:layout_marginTop="12dp"
                    android:text="Allowed apps · All" />

                <Button
                    android:id="@+id/btnBlacklist"
                    style="@style/CardButton"
                    android:layout_marginTop="8dp"
                    android:text="Blocked apps · None" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="System" />

            <LinearLayout style="@style/SettingsCard">

                <include
                    android:id="@+id/rowPowerSaver"
                    layout="@layout/item_switch" />

                <include
                    android:id="@+id/rowForceDark"
                    layout="@layout/item_switch" />

                <include
                    android:id="@+id/rowDebug"
                    layout="@layout/item_switch" />
            </LinearLayout>

            <TextView
                style="@style/SectionHeader"
                android:text="Presets" />

            <LinearLayout style="@style/SettingsCard">

                <Button
                    android:id="@+id/btnSavePreset"
                    style="@style/CardButton"
                    android:text="Save current settings" />

                <Button
                    android:id="@+id/btnLoadPreset"
                    style="@style/CardButton"
                    android:layout_marginTop="8dp"
                    android:text="Load preset" />

                <Button
                    android:id="@+id/btnResetAll"
                    style="@style/CardButtonDestructive"
                    android:layout_marginTop="8dp"
                    android:text="Reset to defaults" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/bottomActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bottom_action_scrim"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="18dp"
        android:paddingEnd="22dp"
        android:paddingBottom="12dp">

        <Button
            android:id="@+id/btnSetWallpaper"
            style="@style/CardButtonPrimary"
            android:text="Set as live wallpaper" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Your changes preview behind these controls"
            android:textColor="#94A0B2"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
