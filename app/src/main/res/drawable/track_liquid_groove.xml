<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <size android:height="8dp"/>
            <corners android:radius="100dp"/>
            <solid android:color="#20FFFFFF"/>
        </shape>
    </item>

    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip android:gravity="left|center_vertical">
            <shape android:shape="rectangle">
                <size android:height="8dp"/>
                <corners android:radius="100dp"/>
                <solid android:color="#A8C7FA"/>
                <gradient
                    android:startColor="#A8C7FA"
                    android:endColor="#4F75B2"
                    android:angle="0"/>
            </shape>
        </clip>
    </item>
</layer-list>