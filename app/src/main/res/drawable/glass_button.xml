<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="22dp" />
            <gradient
                android:angle="135"
                android:startColor="#34FFFFFF"
                android:centerColor="#141E2A3A"
                android:endColor="#08FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#42FFFFFF" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="22dp">
        <shape>
            <corners android:radius="19dp" />
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
