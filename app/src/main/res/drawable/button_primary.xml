<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="135"
                android:startColor="#FF83B4FF"
                android:centerColor="#FF568AF4"
                android:endColor="#FF3E6FE0" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#75FFFFFF" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="28dp">
        <shape>
            <gradient android:angle="270" android:startColor="#42FFFFFF" android:endColor="#00FFFFFF" />
            <corners android:radius="17dp" />
        </shape>
    </item>
</layer-list>
