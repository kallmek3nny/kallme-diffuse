<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:angle="135"
                android:startColor="#38FFFFFF"
                android:centerColor="#151B2638"
                android:endColor="#0AFFFFFF"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="#36FFFFFF" />
        </shape>
    </item>
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape>
            <corners android:radius="27dp" />
            <gradient
                android:angle="270"
                android:startColor="#20FFFFFF"
                android:centerColor="#05FFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="7dp"
        android:right="8dp"
        android:bottom="48dp">
        <shape>
            <corners android:radius="20dp" />
            <gradient
                android:angle="0"
                android:startColor="#28FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
