<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <corners android:radius="28dp" />
            <gradient
                android:angle="135"
                android:startColor="#4AFFFFFF"
                android:centerColor="#24151C26"
                android:endColor="#121D2A3A" />
            <stroke
                android:width="1dp"
                android:color="#4FFFFFFF" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape>
            <corners android:radius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00000000" />
        </shape>
    </item>
    <item
        android:left="16dp"
        android:top="8dp"
        android:right="16dp"
        android:bottom="64dp">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#24FFFFFF" />
        </shape>
    </item>
</layer-list>
